# ==============================================================================
# INFO INSTITUTE OF ENGINEERING - CAMPUS NAVIGATION CONFIGURATION
# ==============================================================================

# Application Base URL (for QR code mobile testing)
VITE_APP_URL=http://localhost:5173

# Leaflet Tile Provider Configuration (defaults to Esri World Imagery & CartoDB)
# No API key required for default legitimate Esri Satellite + CartoDB street tiles.
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_STREET_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Optional Custom Pedestrian Routing API Endpoint (defaults to client-side Dijkstra network)
# VITE_ROUTING_API_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving/
